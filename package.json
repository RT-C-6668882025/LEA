{
  "name": "lea",
  "productName": "LEA",
  "version": "0.2.1",
  "description": "LEA — Learn Everything Anywhere 随处学习一切：任何内容、任何文件夹、任何 Agent 生成的应用都可以打开。",
  "author": "LEA Contributors",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "mcp": "node src/main/mcp-stdio.js",
    "fixtures": "node test/make-fixtures.mjs",
    "test:mcp": "node test/mcp-smoke-test.mjs",
    "icon": "node scripts/make-icon.mjs",
    "build:mcpexe": "node scripts/build-mcp-exe.mjs",
    "build:editor": "node scripts/build-editor-bundle.mjs",
    "dist": "npm run build:editor && node scripts/build-mcp-exe.mjs && electron-builder --win nsis"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "artplayer": "^5.4.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.1.7",
    "jsxgraph": "^1.14.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^14.1.3",
    "pdfjs-dist": "3.11.174",
    "reveal.js": "^4.5.0",
    "sortablejs": "^1.15.7",
    "split.js": "^1.6.5",
    "three": "^0.147.0",
    "viewerjs": "^1.15.2",
    "wavesurfer.js": "^6.6.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.lea.app",
    "productName": "LEA",
    "executableName": "LEA",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "build/mcp-server.exe",
        "to": "mcp-server.exe"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "mcp-server.cmd",
      "skill/**/*",
      "docs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEA",
      "runAfterFinish": true,
      "artifactName": "LEA-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Viewer"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF 文档",
        "description": "PDF 文档",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "文本文档",
        "description": "纯文本文档",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "PNG 图片",
        "description": "PNG 图片",
        "role": "Viewer"
      },
      {
        "ext": "jpg",
        "name": "JPEG 图片",
        "description": "JPEG 图片",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "JPEG 图片",
        "description": "JPEG 图片",
        "role": "Viewer"
      },
      {
        "ext": "gif",
        "name": "GIF 图片",
        "description": "GIF 图片",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP 图片",
        "description": "WebP 图片",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "SVG 图片",
        "description": "SVG 矢量图",
        "role": "Viewer"
      },
      {
        "ext": "html",
        "name": "HTML 页面",
        "description": "HTML 页面（沙箱渲染）",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML 页面",
        "description": "HTML 页面（沙箱渲染）",
        "role": "Viewer"
      },
      {
        "ext": "urpage",
        "name": "UR 可编辑页面",
        "description": "LEA 可编辑页面（文本+媒体+互动块）",
        "role": "Editor"
      },
      {
        "ext": "json",
        "name": "JSON 文件",
        "description": "JSON 数据文件",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 视频",
        "description": "MP4 视频",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM 视频",
        "description": "WebM 视频",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "MP3 音频",
        "description": "MP3 音频",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV 音频",
        "description": "WAV 音频",
        "role": "Viewer"
      }
    ]
  },
  "executableName": "LEA"
}
